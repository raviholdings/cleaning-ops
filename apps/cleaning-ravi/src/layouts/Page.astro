---
import { SITE_CONFIG, SITE_URL } from '../config/site';
import pageCss from '../styles/page.css?raw';

interface Props {
  title: string;
  description: string;
  canonical: string;
  /** JSON-LD @graph 항목 */
  jsonLd?: unknown;
}

const { title, description, canonical, jsonLd } = Astro.props;
const ogImage = `${SITE_URL}/img/hero-1120.webp`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={SITE_CONFIG.indexable ? 'index, follow' : 'noindex, nofollow'} />

    {SITE_CONFIG.naverSiteVerification && (
      <meta name="naver-site-verification" content={SITE_CONFIG.naverSiteVerification} />
    )}
    {SITE_CONFIG.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE_CONFIG.googleSiteVerification} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="alternate" type="application/rss+xml" title={SITE_CONFIG.mainKeyword} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <style set:html={pageCss}></style>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
  </head>

  <body>
    <div class="topbar">📍 전국 출장 가능 · 무료 방문 견적 · 상담 후 비용 결정</div>

    <header>
      <div class="wrap">
        <div class="logo">클린<span>프렌즈</span></div>
        <div class="header-cta">
          <a href="#cpa-form" class="btn-call">무료 견적 신청</a>
        </div>
      </div>
    </header>

    <slot />

    <footer>
      <div class="wrap">
        <strong>클린프렌즈 청소 비교 서비스</strong>
        <div>전국 출장 상담 가능 · 무료 견적 문의</div>
        <div class="disclaimer">
          본 페이지는 청소 관련 서비스 비교·상담 신청을 위한 랜딩페이지이며, 각 CPA 버튼 및 신청 폼은 제휴 파트너사
          페이지로 연결됩니다. 실제 시공은 제휴 파트너사를 통해 진행되며, 본 사이트는 견적 비교 및 상담 신청 매칭 역할을
          합니다. 게재된 이미지는 서비스 이해를 돕기 위한 참고 이미지입니다.
        </div>
      </div>
    </footer>

    <div class="sticky-cta">
      <a href="https://replyalba.com/pt/BtMoZvIUJs" style="background: var(--blue)" target="_blank" rel="noopener"
        >새집느낌</a
      >
      <a href="https://replyalba.com/pt/DD7ERrwYox" style="background: var(--mint)" target="_blank" rel="noopener"
        >이사방청소</a
      >
      <a href="https://replyalba.com/pt/MwNJSXOiNt" style="background: var(--orange)" target="_blank" rel="noopener"
        >24번가 입주청소</a
      >
    </div>
  </body>
</html>
