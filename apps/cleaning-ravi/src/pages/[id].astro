---
import Page from '../layouts/Page.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { SITE_URL } from '../config/site';
import { LOCATIONS, PAGE_COUNT, SITE_INDEX } from '../lib/locations';
import { catalogEntry, pagePath } from '../lib/pageCatalog';
import {
  buildDescription, buildTitle, normalizeLocation,
  pickFaqs, pickReviews, pickNearbyLocations, type TitleVariant,
} from '../lib/pageMeta';

export function getStaticPaths() {
  return Array.from({ length: PAGE_COUNT }, (_, index) => ({
    params: { id: String(index + 1) },
    props: { requestId: index + 1 },
  }));
}

const { requestId } = Astro.props;

const entry = catalogEntry({
  locations: LOCATIONS,
  siteIndex: SITE_INDEX,
  requestId,
  pageCount: PAGE_COUNT,
});

const variant = (import.meta.env.PUBLIC_TITLE_VARIANT === 'A' ? 'A' : 'B') as TitleVariant;

// raw = 지역 목록 원본. 해시 입력은 반드시 이걸 쓴다 (축약형/정식형이 별개 항목이라
// 정규화한 값으로 해시하면 두 페이지 내용이 통째로 같아진다).
// full = 화면 표시용으로 편 것. 서울 동작 흑석동 -> 서울 동작구 흑석동
const raw = entry.location;
const full = normalizeLocation(raw);
const main = entry.mainKeyword;

const title = buildTitle(raw, main, variant);
const description = buildDescription(raw, main, variant);
const canonical = `${SITE_URL}${pagePath(requestId)}`;

const others = Array.from({ length: 15 }, (_, i) => i + 1)
  .map((offset) => ((requestId - 1 + offset * 7) % PAGE_COUNT) + 1)
  .filter((id) => id !== requestId)
  .slice(0, 10)
  .map((id) => {
    const other = catalogEntry({ locations: LOCATIONS, siteIndex: SITE_INDEX, requestId: id, pageCount: PAGE_COUNT });
    return {
      href: pagePath(id),
      label: `${normalizeLocation(other.location)} ${other.mainKeyword} 업체 비교`,
    };
  });

const FAQS = pickFaqs(raw, main);
const REVIEWS = pickReviews(raw, main, 3);
const NEARBY = pickNearbyLocations(raw, LOCATIONS, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: '홈',
          item: `${SITE_URL}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `${full} ${main}`,
          item: canonical,
        },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      serviceType: main,
      name: `${full} ${main} 업체 비교`,
      description,
      url: canonical,
      areaServed: [full, ...NEARBY].map((loc) => ({
        '@type': 'AdministrativeArea',
        name: loc,
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: FAQS.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Page title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="wrap hero-inner">
      <span class="badge">{full} {main} 비교 플랫폼</span>
      <h1>
        {full} {main}<br /><em>3곳 무료 비교 견적</em>으로<br />가장 합리적인 곳을 선택하세요
      </h1>
      <p>
        혼자 알아보면 시간도 오래 걸리고 가격 비교도 어렵습니다. 클린프렌즈가 {full} 검증된 업체 3곳의 견적을 한 번에 모아 비교해드립니다.
      </p>
      <div class="hero-stats">
        <div><strong>4.8 / 5.0</strong>평균 고객 만족도</div>
        <div><strong>32,000+</strong>누적 견적 매칭 건수</div>
        <div><strong>30분</strong>평균 상담 회신 시간</div>
      </div>
      <div class="cpa-row">
        <a class="cpa-btn c1" href="https://replyalba.com/pt/BtMoZvIUJs" target="_blank" rel="noopener"
          >✨ 새집느낌<small>홈케어 전문 청소</small></a
        >
        <a class="cpa-btn c2" href="https://replyalba.com/pt/DD7ERrwYox" target="_blank" rel="noopener"
          >🧹 이사방청소<small>비교 후 진행하는 청소</small></a
        >
        <a class="cpa-btn c3" href="https://replyalba.com/pt/MwNJSXOiNt" target="_blank" rel="noopener"
          >🚀 24번가 입주청소<small>가격비교 업계 1위</small></a
        >
      </div>
    </div>
  </section>

  <!-- ===== COMPARE ===== -->
  <section id="compare">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Compare</span>
        <h2>{full} {main}, 어느 업체가 나에게 맞을까요?</h2>
        <p>고객님의 조건에 맞는 우수 업체 3곳을 찾았습니다. 후기와 특징을 비교해보고 견적을 신청하세요.</p>
      </div>
      <div class="vendor-grid">
        <div class="vendor-card best">
          <span class="vendor-flag">🔥 BEST 1위 추천</span>
          <div class="vendor-top">
            <div class="vendor-thumb-wrap">
              <span class="vendor-num">1</span>
              <img
                src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=200&h=200&q=80"
                alt="새집느낌 청소 담당자"
              />
            </div>
            <div>
              <h3>새집느낌</h3>
              <div class="vendor-stars">★★★★★ <span>4.9</span> <em>(1,890+)</em></div>
            </div>
          </div>
          <div class="vendor-feat-box">
            <div>✓ 홈케어 한 가지만 연구해온 전문 청소업체</div>
            <div>✓ 친환경 세정제·피톤치드 살균 소독 포함</div>
          </div>
          <a class="vendor-cta" href="https://replyalba.com/pt/BtMoZvIUJs" target="_blank" rel="noopener"
            >해당 업체 무료 견적 받기</a
          >
        </div>

        <div class="vendor-card">
          <div class="vendor-top">
            <div class="vendor-thumb-wrap">
              <span class="vendor-num">2</span>
              <img
                src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=200&h=200&q=80"
                alt="이사방청소 담당자"
              />
            </div>
            <div>
              <h3>이사방청소</h3>
              <div class="vendor-stars">★★★★★ <span>4.8</span> <em>(1,100+)</em></div>
            </div>
          </div>
          <div class="vendor-feat-box">
            <div>✓ 여러 업체를 비교한 뒤 진행하는 검증형 매칭 서비스</div>
            <div>✓ {full} 및 전국 신속 출동, 당일 견적 비교 가능</div>
          </div>
          <a class="vendor-cta" href="https://replyalba.com/pt/DD7ERrwYox" target="_blank" rel="noopener"
            >해당 업체 무료 견적 받기</a
          >
        </div>

        <div class="vendor-card">
          <div class="vendor-top">
            <div class="vendor-thumb-wrap">
              <span class="vendor-num">3</span>
              <img
                src="https://images.unsplash.com/photo-1563453392212-326f5e854473?auto=format&fit=crop&w=200&h=200&q=80"
                alt="24번가 입주청소 담당자"
              />
            </div>
            <div>
              <h3>24번가 입주청소</h3>
              <div class="vendor-stars">★★★★★ <span>4.8</span> <em>(1,890+)</em></div>
            </div>
          </div>
          <div class="vendor-feat-box">
            <div>✓ 전국 입주·이사청소 가격비교 업계 압도적 1등</div>
            <div>✓ 24시간 언제든 온라인 접수, 합리적인 가성비</div>
          </div>
          <a class="vendor-cta" href="https://replyalba.com/pt/MwNJSXOiNt" target="_blank" rel="noopener"
            >해당 업체 무료 견적 받기</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CPA FORM ===== -->
  <section class="form-section" id="cpa-form">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow" style="color: #8fb4ff">Free Quote</span>
        <h2>30초면 끝! {full} {main} 무료 비교 견적 신청</h2>
        <p>아래 폼을 작성하면 제휴 업체와 바로 연결됩니다.</p>
      </div>

      <EstimateForm heading="무료 맞춤 견적 신청" note="30초 접수 · 비교 후 연결 · 강요 없음" />
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="process">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Process</span>
        <h2>상담부터 완료까지, 5단계로 진행됩니다</h2>
        <p>모든 단계에서 범위와 비용을 먼저 안내한 뒤 작업합니다.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num">1</div>
          <h4>상담·견적</h4>
          <p>평수와 원하는 {main} 서비스를 확인하고 견적을 안내합니다.</p>
        </div>
        <div class="step">
          <div class="num">2</div>
          <h4>업체 비교</h4>
          <p>{full} 조건에 맞는 업체 1~3곳을 매칭해 비교해드립니다.</p>
        </div>
        <div class="step">
          <div class="num">3</div>
          <h4>일정 확정</h4>
          <p>이사·입주 일정에 맞춰 방문 날짜를 확정합니다.</p>
        </div>
        <div class="step">
          <div class="num">4</div>
          <h4>현장 청소</h4>
          <p>전문 장비로 안내된 범위 기준 작업을 진행합니다.</p>
        </div>
        <div class="step">
          <div class="num">5</div>
          <h4>검수·완료</h4>
          <p>함께 확인 후 미흡한 부분은 즉시 보완합니다.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== GALLERY ===== -->
  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Gallery</span>
        <h2>이런 공간을 이렇게 청소합니다</h2>
      </div>
      <div class="gallery-grid">
        <img
          src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=500&q=80"
          alt="욕실 청소 전후"
        />
        <img
          src="https://images.unsplash.com/photo-1615874959474-d609969a20ed?auto=format&fit=crop&w=500&q=80"
          alt="이사 후 빈 방 청소"
        />
        <img
          src="https://images.unsplash.com/photo-1493809842364-78817add7ffb?auto=format&fit=crop&w=500&q=80"
          alt="깨끗한 거실 공간"
        />
        <img
          src="https://images.unsplash.com/photo-1527515637462-cff94eecc1ac?auto=format&fit=crop&w=500&q=80"
          alt="청소 도구와 장비"
        />
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS / REVIEWS ===== -->
  <section id="reviews">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Review</span>
        <h2>{full} 먼저 이용해본 고객들의 이야기</h2>
      </div>
      <div class="testi-grid">
        {REVIEWS.map((review) => (
          <div class="testi">
            <div class="stars">{'★'.repeat(review.rating)}</div>
            "{review.text}"
            <div class="who">{review.author} 님 · {review.service}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LOCATION ===== -->
  <section id="location">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Location</span>
        <h2>서비스 제공 지역 안내</h2>
      </div>
      <div class="location-box">
        <h3>📍 담당 서비스 지역: {full}</h3>
        <p class="lede-sm">
          {full} 지역을 포함하여 인근 동네까지 전담 검증팀이 직접 방문하여 서비스를 진행합니다.
        </p>
        {NEARBY.length > 0 && (
          <p class="lede-sm">
            <strong>주변 주요 방문 지역:</strong> {NEARBY.join(', ')}
          </p>
        )}
        <div class="location-map-stub">
          🗺️ {full} 및 인근 {NEARBY.length}개 동네 지도 기반 배정 시스템 운영 중
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>자주 묻는 질문</h2>
      </div>
      <div class="faq-list">
        {FAQS.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== RELATED LINKS ===== -->
  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Links</span>
        <h2>다른 관련 항목 안내</h2>
      </div>
      <nav class="links">
        {others.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </section>
</Page>
