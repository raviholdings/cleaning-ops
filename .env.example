# ==========================================
# Database (Supabase / PostgreSQL)
# ==========================================
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# ==========================================
# Naver Open API (Search / DataLab)
# ==========================================
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ==========================================
# Cloudflare & Asset Storage (R2)
# ==========================================
CLOUDFLARE_EMAIL=your_email@domain.com
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_r2_bucket_name

# ==========================================
# Geographic Data (SGIS API)
# ==========================================
SGIS_CONSUMER_KEY=your_sgis_consumer_key
SGIS_CONSUMER_SECRET=your_sgis_consumer_secret

# ==========================================
# External Lead Router
# ==========================================
PUBLIC_LEAD_ROUTER_BASE_URL=https://nichebox.siwol.kr

# ==========================================
# Runner Controls
# ==========================================
CRAWL_RUNNER_PC=siwol-win

# ==========================================
# Static Site Build (apps/cleaning-ravi)
# ------------------------------------------
# Read by apps/cleaning-ravi/src/config/site.ts. Only PUBLIC_*-prefixed values
# reach the browser bundle. Override these per target domain, e.g.
#
#   PUBLIC_SITE_URL=https://mydomain.kr \
#   PUBLIC_SITE_AREA_NAME=강남구 \
#   PUBLIC_NAVER_SITE_VERIFICATION=<Search Advisor HTML tag content> \
#   ASTRO_DIST_DIR=dist/mydomain.kr \
#   npm run build
# ==========================================
PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=입주청소114
PUBLIC_SITE_REGION=강남·서초·송파
PUBLIC_SITE_CITY=서울특별시
PUBLIC_SITE_AREA_NAME=강남구
PUBLIC_SITE_MAIN_KEYWORD=입주청소

# Search Advisor "HTML 태그" ownership check. Empty until the domain is added in
# Search Advisor; naver_ownership_only.py needs this tag live on the deployed site.
PUBLIC_NAVER_SITE_VERIFICATION=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to false on staging builds to emit noindex + Disallow.
PUBLIC_SITE_INDEXABLE=true

# Lead-capture iframe and footer identifiers.
PUBLIC_LEAD_FORM_URL=https://replyalba.com/intros/_frm/index.php?code=wKSpzJlHMP
PUBLIC_TELEGRAM_URL=https://t.me/
PUBLIC_BUSINESS_REGISTRATION_NUMBER=
PUBLIC_MAIL_ORDER_NUMBER=

# Output directory for the Astro build (relative to apps/cleaning-ravi).
ASTRO_DIST_DIR=dist

# ==========================================
# Naver ownership verification (naver_ownership_only.py)
# ==========================================
NAVER_OWNERSHIP_ACCOUNT_ID=
NAVER_OWNERSHIP_GROUP_KEY=cleaning-ravi
NAVER_OWNERSHIP_PROJECT_KEY=cleaning-ravi

# ==========================================
# 프록시 (계정별 IP 관리)
# ==========================================
# HaiIP 는 회선 하나로 IP 를 하나만 유지할 수 있어 계정을 순차로만 돌릴 수 있다.
# 프록시를 쓰면 계정별 IP 를 동시에 잡을 수 있고, 켜면 HaiIP 호출을 자동으로 건너뛴다.
# 업체 무관(Webshare / 커스텀 등). CLI 로는 --use-proxy 로도 켤 수 있다.
NAVER_PROXY_ENABLED=0
NAVER_PROXY_SERVER=
NAVER_PROXY_USERNAME=
NAVER_PROXY_PASSWORD=

# 계정마다 다른 프록시를 쓰려면 JSON 파일 경로를 지정한다. 전역 설정보다 우선한다.
#   { "lguxp4nlw": { "server": "http://host:port", "username": "u", "password": "p" } }
NAVER_PROXY_ACCOUNT_MAP=

# 아래 이름도 같은 의미로 인식한다(지시서 호환).
BRIGHT_DATA_PROXY_ENABLED=0
BRIGHT_DATA_PROXY_SERVER=
BRIGHT_DATA_PROXY_USERNAME=
BRIGHT_DATA_PROXY_PASSWORD=
