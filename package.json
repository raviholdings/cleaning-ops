{
  "name": "cleaning-ops",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm --workspace=apps/cleaning-admin run dev",
    "build:admin": "npm --workspace=apps/cleaning-admin run build",
    "start:admin": "npm --workspace=apps/cleaning-admin run preview",
    "preview:admin": "npm --workspace=apps/cleaning-admin run preview",
    "dev:ravi": "npm --workspace=apps/cleaning-ravi run dev",
    "build:ravi": "npm --workspace=apps/cleaning-ravi run build",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:migrate:dry": "node scripts/apply-migrations.mjs --dry-run",
    "domains:register": "node scripts/register-naver-project-domains.mjs",
    "crawl:resume": "powershell -File ./scripts/run-windows-naver-crawl-resume.ps1",
    "render:one": "node scripts/render-static-site.mjs",
    "render:vars": "node scripts/render-static-site.mjs --inspect",
    "render:compare": "node scripts/compare-static-render.mjs"
  },
  "dependencies": {
    "pg": "^8.11.3",
    "playwright": "^1.40.0"
  }
}
