node_modules/
.env
.env.local
.env.*.local
tmp/
logs/
dist/
dist-preview/
.astro/
apps/*/node_modules/
apps/*/dist/
apps/*/tmp/
apps/*/.astro/
.git/lost-found/
private/
local-secrets/
*.corrupt.bak

# 임시 작업 및 세션 복구 로그 폴더
recovered/
recovered*
scratch/

# 런타임 락 파일 및 바이너리/실행 파일
*.lock
.windows-naver-crawl.lock
*.exe
_binary/.vite/
apps/*/.vite/

# 머신마다 다르게 쌓이는 실행 기록. 추적하면 VM 이 git pull 할 때마다
# "local changes would be overwritten" 으로 막힌다. 계획 파일(reports/*.json)은
# 배치 재현에 필요하므로 계속 추적한다.
reports/haiip-windows-ip-changes.jsonl
reports/naver-login/
reports/verify-debug.png
verify_debug.png

# 개발현황은 public.dev_tasks 로 옮겼다. 이 파일은 이전 백업일 뿐이라
# 추적하면 VM 이 git pull 할 때 막히기만 한다.
data/dev_tasks.json

# 작업 중 만든 미리보기 HTML 과 스크린샷. 결과물이 아니라 확인용이다.
/preview_*.html
/preview_*.png
/built_*.png
/final_*.png
/take_preview_screenshot.mjs

# 실행 리포트는 기계마다 다르게 쌓인다. 공유할 이유가 없다.
/reports/

# 청소 이미지 500장(31MB)은 로컬 전용이다. 배포는 git 을 거치지 않고
# R2 에 올려 assets.<루트> 로 서빙한다. 커밋하면 저장소만 무거워진다.
/apps/cleaning-ravi/public/cleaning/
.claude/settings.local.json

# 브랜드 사이트 5개(드림컴뚜러·썬더배관·비버배관·싹쓰리배관·하수구도사) 사진.
# 청소 이미지와 같은 방침이다 — 로컬 전용이고 배포는 git 을 거치지 않는다.
#   output/                       원본 자산 71M (현장·작업사례·개별사용·히어로·로고)
#   apps/brand-static/*/assets/img/  굽기용 사본 68M
#   assets/branding/              로고·파비콘 원본 11M
# 사진이 없으면 빌더가 "이미지가 없습니다" 로 멈춘다. 다른 기계에서 구우려면
# 위 세 폴더를 그대로 복사해 와야 한다 (docs/BRAND-SITES-PHOTOS.md 참고).
/output/
/apps/brand-static/*/assets/img/
/assets/branding/

# 파이썬 캐시
__pycache__/
*.pyc
